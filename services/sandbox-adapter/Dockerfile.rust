# Rust-build runtime image — stub for future deployment.
# Replace the RUN layer below with packages needed for your Rust workloads.
# Check https://developers.cloudflare.com/sandbox/configuration/dockerfile/
# for the current recommended cloudflare/sandbox base tag before deploying.
FROM docker.io/cloudflare/sandbox:0.7.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/* \
    && curl https://sh.rustup.rs -sSf | sh -s -- -y --default-toolchain stable \
    && ~/.cargo/bin/rustup component add rustfmt clippy
