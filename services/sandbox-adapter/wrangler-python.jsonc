{
  // Python-build runtime adapter — separate Worker deployment with a Python-focused image.
  // Deploy with: npx wrangler deploy --config wrangler-python.jsonc
  // Set SANDBOX_ADAPTER_URL_PYTHON in the core service's .env to this Worker's URL.
  "name": "compute-router-python",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Sandbox",
      // Replace with a Dockerfile that installs Python, pip, venv, and common
      // data-science / ML packages.  The node-build Dockerfile is the template.
      "image": "./Dockerfile.python",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "Sandbox", "name": "Sandbox" }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["Sandbox"], "tag": "v1" }
  ],
  "vars": {
    "SANDBOX_TRANSPORT": "rpc"
  }
}
