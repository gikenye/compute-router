# Core service
PORT=8080
CELO_NETWORK=celo-mainnet
CELO_CHAIN_CAIP2=eip155:42220


X402_FACILITATOR_URL=https://api.x402.celo.org
X402_API_KEY=
CELO_RPC_URL=https://forno.celo.org

USDC_TOKEN_ADDRESS=0xcEBA9300f2b948710d2653dD7B07f33A8B32118C
USDT_TOKEN_ADDRESS=0x48065fbbe25f71c9282ddf5e1cd6d6a887483d5e

PAYOUT_WALLET=

SANDBOX_ADAPTER_URL=http://localhost:8787   # local `wrangler dev` default port
SANDBOX_ADAPTER_SHARED_SECRET=dev-local-secret-change-me   # MUST match services/sandbox-adapter/.dev.vars

PRICE_PER_BLOCK_USD=0.02
BLOCK_MINUTES=2

# Optional command safety check
SAFETY_CHECK_ENABLED=false
CENCORI_API_BASE_URL=
CENCORI_API_KEY=
SAFETY_CHECK_FAIL_OPEN=true
REFUND_LEDGER_PATH=./data/refund-ledger.jsonl
# Optional operator key for confirmed failed-settlement refunds.
# It must derive to PAYOUT_WALLET and should be stored as a deployment secret.
# AGENT_OPERATOR_PRIVATE_KEY=
ATTRIBUTION_ASSIGNED_TAG=celo_9f3a3bce8894

# Agent identity and discovery
AGENT_NAME=Compute Router
AGENT_DESCRIPTION=Agent-native metered compute sandboxes, paid for in USDC or USDT on Celo via x402.
AGENT_IMAGE_URI=                         # ipfs:// or https:// — leave blank until you have real artwork, don't fabricate one
AGENT_MCP_PUBLIC_URL=https://mcp.computerouter.wtf/mcp

# Sandbox adapter settings (configured separately for the Worker)
# ADAPTER_SHARED_SECRET=dev-local-secret-change-me
