# --- Core service (services/core) — read directly by internal/config ---
PORT=8080
CELO_NETWORK=celo-sepolia
CELO_CHAIN_CAIP2=eip155:11142220        # Sepolia. Mainnet = eip155:42220 — VERIFY before switching

X402_FACILITATOR_URL=https://api.x402.sepolia.celo.org
X402_API_KEY=                            # server-side secret — required for /settle

USDC_TOKEN_ADDRESS=                      # VERIFY current Sepolia USDC address, do not assume from memory
PAYOUT_WALLET=                           # plain receiving address — this repo never holds a signing wallet

SANDBOX_ADAPTER_URL=http://localhost:8787   # local `wrangler dev` default port
SANDBOX_ADAPTER_SHARED_SECRET=dev-local-secret-change-me   # MUST match services/sandbox-adapter/.dev.vars

PRICE_PER_BLOCK_USD=0.02
BLOCK_MINUTES=2

# --- Sandbox adapter (services/sandbox-adapter) — set via .dev.vars locally,
#     `wrangler secret put` in the cloud. Listed here for visibility only,
#     NOT read from this file by the Worker. ---
# ADAPTER_SHARED_SECRET=dev-local-secret-change-me
